# Copy to .env for local development (gitignored). In CI these come from GitHub secrets.

# LLM (OpenRouter) — required
OPENROUTER_API_KEY=

# Source enrichment — optional (higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Email digest (Gmail SMTP) — required for Phase 5+
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Recipient list, NEVER committed. Comma-separated emails or JSON array.
SUBSCRIBERS=

# Hugging Face (web app / Space deploy) — optional
HF_TOKEN=

# Debug: 1 to write a full run trace to logs/run-<date>.log
WAM_DEBUG=
